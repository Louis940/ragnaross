---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("docs", ({ id }) => id.startsWith("unprofessionals/"));
  return entries.map((entry) => {
    const slug = entry.id.replace(/^unprofessionals\//, "");
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = `${entry.data.title} — Louis Ross`;
---

<BaseLayout title={title} description={entry.data.description}>
  <main class="mx-auto max-w-3xl px-6 py-8">
    <a class="link link-primary link-hover mb-6 inline-block text-sm" href="/unprofessionals"
      >← Hobbies</a
    >
    <article
      class="prose prose-neutral max-w-none prose-headings:font-bold prose-p:leading-relaxed"
    >
      <Content />
    </article>
  </main>
</BaseLayout>

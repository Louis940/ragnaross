---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { articleSlug, sectionUrlPath } from "../../../lib/content";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) =>
    data.section.startsWith("unprofessionals/"),
  );

  return articles.map((article) => ({
    params: {
      slug: article.data.section.replace(/^unprofessionals\//, ""),
      article: articleSlug(article),
    },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const allSections = await getCollection("sections");
const parentSection = allSections.find((entry) => entry.id === article.data.section);
const sectionPath = sectionUrlPath({ id: article.data.section } as typeof article);
const title = `${article.data.title} — Louis Ross`;
---

<BaseLayout title={title} description={article.data.description}>
  <main class="mx-auto max-w-3xl px-6 py-8">
    <a class="link link-primary link-hover mb-6 inline-block text-sm" href="/unprofessionals"
      >← Hobbies</a
    >
    <a
      class="link link-primary link-hover mb-6 ml-4 inline-block text-sm"
      href={`/unprofessionals/${sectionPath}`}
    >
      ← {parentSection?.data.title ?? sectionPath}
    </a>

    <article
      class="prose prose-neutral max-w-none prose-headings:font-bold prose-p:leading-relaxed"
    >
      <header class="not-prose mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-base-content">{article.data.title}</h1>
        {
          article.data.rating != null && (
            <p class="mt-2 text-sm text-base-content/70">Rating: {article.data.rating}/5</p>
          )
        }
      </header>
      <Content />
    </article>
  </main>
</BaseLayout>

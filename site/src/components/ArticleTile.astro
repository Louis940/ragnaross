---
interface Props {
  article: import("astro:content").CollectionEntry<"articles">;
  href: string;
}

const { article, href } = Astro.props;
const { title, description, image, rating } = article.data;
---

<a
  href={href}
  class="card border border-base-300 bg-base-100 shadow-sm transition-colors hover:bg-base-200/60"
>
  {
    image && (
      <figure class="aspect-[4/3] overflow-hidden bg-base-200">
        <img src={image} alt="" class="h-full w-full object-cover" loading="lazy" />
      </figure>
    )
  }
  <div class="card-body gap-2 p-5">
    <div class="flex items-start justify-between gap-3">
      <h2 class="card-title text-base leading-snug">{title}</h2>
      {rating != null && <span class="badge badge-ghost shrink-0">{rating}/5</span>}
    </div>
    {description && <p class="text-sm leading-relaxed text-base-content/70">{description}</p>}
  </div>
</a>
